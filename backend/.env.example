APP_NAME=Lenny Growth Assistant API
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_growth_assistant
LLM_PROVIDER=ollama

# Implementation decision: qwen3:4b is the default local model for this development machine.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120

# Optional cloud providers. Keep the key only in local .env or a secret manager.
# Set LLM_PROVIDER=claude_agent to use the official Claude Agent SDK.
ANTHROPIC_API_KEY=
ANTHROPIC_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_TIMEOUT_SECONDS=120
