APP_NAME=Lenny Growth Assistant API
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_growth_assistant
# Absolute or relative path to the local transcript archive. An empty index is seeded on startup.
TRANSCRIPT_DIRECTORY=../data/transcripts
LLM_PROVIDER=ollama

# Implementation decision: qwen2.5:1.5b avoids the slow reasoning phase of qwen3:4b on this development machine.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_MAX_OUTPUT_TOKENS=512
# Longer generation budget for the approximately 1,250-word artifact skill.
OLLAMA_ARTIFACT_TIMEOUT_SECONDS=180
OLLAMA_ARTIFACT_MAX_OUTPUT_TOKENS=1800

# Optional cloud providers. Keep the key only in local .env or a secret manager.
# Set LLM_PROVIDER=claude_agent to use the official Claude Agent SDK.
ANTHROPIC_API_KEY=
ANTHROPIC_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_TIMEOUT_SECONDS=120
